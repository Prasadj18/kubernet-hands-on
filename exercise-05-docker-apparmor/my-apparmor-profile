#include <tunables/global>

profile my-apparmor-profile flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  # Allow the Python application and its libraries to be read
  /app/** r,
  /usr/local/bin/python* mr,
  /usr/local/lib/** r,
  /usr/lib/** r,
  /lib/** r,

  # Required system configuration
  /etc/hosts r,
  /etc/hostname r,
  /etc/resolv.conf r,
  /etc/ssl/** r,
  /etc/ld.so.cache r,

  # Allow application networking
  network inet stream,
  network inet dgram,
  network inet6 stream,
  network inet6 dgram,

  # Basic runtime access
  /dev/null rw,
  /dev/zero rw,
  /dev/urandom r,
  /proc/** r,

  # Explicitly deny sensitive files and shell execution
  deny /etc/shadow r,
  deny /etc/gshadow r,
  deny /bin/bash x,
  deny /bin/sh x,

  # Deny writes to system configuration and directories
  deny /etc/** w,
  deny /var/** w,
}
